# VirtualSphere Backend Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/virtualsphere
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=24h
BCRYPT_ROUNDS=12

# LLM Service Configuration (Patent Core Technology)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# Personal LLM Instance Configuration
LLM_INSTANCE_PREFIX=vs_llm_
LLM_MEMORY_SIZE=1000
LLM_LEARNING_RATE=0.001

# Virtual Human Configuration (Patent Core Technology)
VH_AUTONOMY_LEVEL=0.8
VH_INTERACTION_COOLDOWN=1000
VH_EVOLUTION_THRESHOLD=100

# Emotion Analysis Configuration (Patent Core Technology)
EMOTION_ANALYSIS_MODEL=sentiment
EMOTION_THRESHOLD_POSITIVE=0.6
EMOTION_THRESHOLD_NEGATIVE=-0.4
CONTEXT_WINDOW_SIZE=10

# Dynamic World Generation (Patent Core Technology)
WORLD_UPDATE_INTERVAL=5000
WORLD_GENERATION_DEPTH=3
COLLECTIVE_IMAGINATION_WEIGHT=0.7

# Blockchain Configuration (Patent Implementation)
ETHEREUM_NODE_URL=https://mainnet.infura.io/v3/your_project_id
PRIVATE_KEY=your_ethereum_private_key
CONTRACT_ADDRESS_NFT=0x...
CONTRACT_ADDRESS_TOKEN=0x...
GAS_LIMIT=500000

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Logging
LOG_LEVEL=info
LOG_FILE=logs/virtualsphere.log

# API Documentation
SWAGGER_ENABLED=true

# External Services
WEATHER_API_KEY=your_weather_api_key
NEWS_API_KEY=your_news_api_key

# Performance & Caching
CACHE_TTL=3600
MAX_CONCURRENT_LLM_REQUESTS=10
DATABASE_POOL_SIZE=10

# Development Tools
DEBUG_MODE=true
MOCK_BLOCKCHAIN=false
MOCK_LLM=false
