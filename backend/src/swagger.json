{
  "swagger": "2.0",
  "info": {
    "title": "VirtualSphere API",
    "version": "1.0.0",
    "description": "LLM-based Virtual Social Network System API Documentation",
    "contact": {
      "name": "Ucaretron Inc.",
      "email": "support@virtualsphere.com"
    }
  },
  "host": "localhost:5000",
  "basePath": "/api/v1",
  "schemes": ["http", "https"],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter JWT Bearer token"
    }
  },
  "tags": [
    {
      "name": "Authentication",
      "description": "User authentication endpoints"
    },
    {
      "name": "Virtual Humans",
      "description": "Virtual human management endpoints"
    },
    {
      "name": "Dynamic Worlds",
      "description": "Dynamic world creation and management"
    },
    {
      "name": "Emotions",
      "description": "Emotion recognition and analysis"
    },
    {
      "name": "LLM",
      "description": "Personal LLM instance management"
    },
    {
      "name": "Collaborations",
      "description": "Collaboration project management"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "username": { "type": "string" },
                "email": { "type": "string" },
                "password": { "type": "string" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created successfully"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login user",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": { "type": "string" },
                "password": { "type": "string" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    },
    "/virtual-humans/create": {
      "post": {
        "tags": ["Virtual Humans"],
        "summary": "Create a virtual human",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "personality": {
                  "type": "object",
                  "properties": {
                    "creativity": { "type": "number" },
                    "empathy": { "type": "number" },
                    "analyticalThinking": { "type": "number" }
                  }
                },
                "autonomyLevel": { "type": "number" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Virtual human created successfully"
          }
        }
      }
    },
    "/virtual-humans/me": {
      "get": {
        "tags": ["Virtual Humans"],
        "summary": "Get my virtual human",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Virtual human data"
          }
        }
      }
    },
    "/worlds/create": {
      "post": {
        "tags": ["Dynamic Worlds"],
        "summary": "Create a new dynamic world",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "worldType": {
                  "type": "string",
                  "enum": ["city", "nature", "abstract", "hybrid", "custom"]
                },
                "isPublic": { "type": "boolean" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "World created successfully"
          }
        }
      }
    },
    "/worlds/active": {
      "get": {
        "tags": ["Dynamic Worlds"],
        "summary": "Get active worlds",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "type": "integer",
            "description": "Number of worlds to return"
          }
        ],
        "responses": {
          "200": {
            "description": "List of active worlds"
          }
        }
      }
    },
    "/emotions/process": {
      "post": {
        "tags": ["Emotions"],
        "summary": "Process emotion data",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "dataType": {
                  "type": "string",
                  "enum": ["facial", "voice", "text", "biometric", "composite"]
                },
                "rawData": {
                  "type": "object"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Emotion data processed"
          }
        }
      }
    },
    "/emotions/analytics": {
      "get": {
        "tags": ["Emotions"],
        "summary": "Get emotion analytics",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "type": "string",
            "description": "Analysis period (e.g., 7d, 30d)"
          }
        ],
        "responses": {
          "200": {
            "description": "Emotion analytics data"
          }
        }
      }
    },
    "/llm/instances": {
      "post": {
        "tags": ["LLM"],
        "summary": "Create personal LLM instance",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "creativity": { "type": "number" },
                    "temperature": { "type": "number" },
                    "model": { "type": "string" }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "LLM instance created"
          }
        }
      }
    },
    "/collaborations": {
      "post": {
        "tags": ["Collaborations"],
        "summary": "Create a collaboration project",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "description": { "type": "string" },
                "type": { "type": "string" },
                "requiredSkills": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Collaboration created"
          }
        }
      }
    }
  }
}
